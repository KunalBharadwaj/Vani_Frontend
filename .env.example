# ─── Vani Frontend environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# Base URL of the Vani backend (HTTP; the app derives the ws:// URL from it).
# Local dev:  http://localhost:3001
# Production: https://vani-backend-mjsl.onrender.com
VITE_BACKEND_URL=http://localhost:3001
